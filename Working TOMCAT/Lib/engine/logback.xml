<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!-- Stop output INFO at start -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <property name="loghome" value="" />

    <appender name="RoutingWebLogFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${loghome}/WebContainerLogs/WebContainerLogFile.log</file>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.iexceed.webcontainer.logger.MaskingPatternLayout">
                <maskPattern>\"pwd\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"pin\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"oldPassword\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"newPassword\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"confirmPassword\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"hashKey1\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"hashKey2\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"requestKey\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>\"deviceId\"\s*:\s*\"(.*?)\"</maskPattern>
                <maskPattern>(\d+\.\d+\.\d+\.\d+)</maskPattern>
                <Pattern>%d %p %-40c{1.} %m %n</Pattern>
            </layout>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- rollover daily -->
            <fileNamePattern>${loghome}/WebContainerLogs/WebContainerLogFile-%d{yyyy-MM-dd}-%i.zip</fileNamePattern>
            <maxFileSize>4MB</maxFileSize>
        </rollingPolicy>
    </appender>

    <Logger name="com.iexceed.webcontainer" level="DEBUG">
        <AppenderRef ref="RoutingWebLogFile" level="DEBUG" />
    </Logger>

    <root level="DEBUG">
        <appender-ref ref="RoutingWebLogFile" />
    </root>

</configuration>
